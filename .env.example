# Copia este archivo como .env para desarrollo local (.env nunca va al repositorio).
# Con estos valores todo funciona SIMULADO: no hace falta ninguna llave.
# Detalle: docs/05-arquitectura.md §10 y docs/10-integracion-bolsa.md §9.

# --- Entorno: local | ci | demo | mvp (en mvp se prohíben los simulados) ---
ENTORNO=local

# --- Proveedores: simulado | real ---
# mercado = Alpaca Market Data · broker = Alpaca paper · noticias = Alpaca News
# contexto = DeepSeek · jev = TypeSafe o Cloudflare · push = Firebase Cloud Messaging
PROVEEDOR_MERCADO=simulado
PROVEEDOR_BROKER=simulado
PROVEEDOR_NOTICIAS=simulado
PROVEEDOR_CONTEXTO=simulado
PROVEEDOR_JEV=simulado
PROVEEDOR_PUSH=simulado

# --- Alpaca (solo si algún proveedor de Alpaca es real) ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- DeepSeek (contexto) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- JEV (decisión): typesafe | cloudflare ---
JEV_PROVEEDOR=typesafe
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Firebase Cloud Messaging: JSON de la cuenta de servicio, en una línea ---
FCM_CUENTA_SERVICIO=

# --- Llamadas internas (cron → funciones) ---
SECRETO_INTERNO=cambia-esto-en-local

# --- App Flutter (se pasan con --dart-define; no son secretos) ---
SUPABASE_URL=http://127.0.0.1:54321
# La imprime `supabase start`
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_WEB_CLIENT_ID=
# Habilita el ingreso con correo SOLO en local y CI
MODO_PRUEBAS=true
