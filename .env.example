# Copia este archivo como .env para desarrollo local (.env nunca va al repositorio).
# Con estos valores todo funciona SIMULADO: no hace falta ninguna llave.
# Detalle: docs/05-arquitectura.md §10 y docs/10-integracion-bolsa.md §9.

# --- Entorno: local | ci | demo | mvp (en mvp se prohíben los simulados) ---
ENTORNO=local

# --- Proveedores: simulado, o el nombre del proveedor real (docs/10 §9) ---
# Nunca "real": _shared/proveedores.ts solo acepta "simulado" o el nombre de un proveedor.
#   PROVEEDOR_MERCADO  simulado | alpaca              (Alpaca Market Data)
#   PROVEEDOR_BROKER   simulado | alpaca              (Alpaca paper)
#   PROVEEDOR_JEV      simulado | typesafe | cloudflare
#   PROVEEDOR_NOTICIAS simulado | alpaca              (Alpaca News)   FUERA DEL MVP CORTO (D-59)
#   PROVEEDOR_CONTEXTO simulado | deepseek                            FUERA DEL MVP CORTO (D-59)
#   PROVEEDOR_PUSH     simulado | fcm                                 FUERA DEL MVP CORTO (D-62)
# Ninguna función usa todavía noticias, contexto ni push: déjalos en simulado en local.
PROVEEDOR_MERCADO=simulado
PROVEEDOR_BROKER=simulado
PROVEEDOR_NOTICIAS=simulado
PROVEEDOR_CONTEXTO=simulado
PROVEEDOR_JEV=simulado
PROVEEDOR_PUSH=simulado

# --- Alpaca (solo si algún proveedor de Alpaca es real) ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- DeepSeek (contexto) · FUERA DEL MVP CORTO (D-59): no hace falta ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- JEV (decisión): typesafe | cloudflare ---
JEV_PROVEEDOR=typesafe
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Firebase Cloud Messaging · FUERA DEL MVP CORTO (D-62): no hace falta ---
# JSON de la cuenta de servicio, en una línea
FCM_CUENTA_SERVICIO=

# --- Llamadas internas (cron → funciones) ---
SECRETO_INTERNO=cambia-esto-en-local

# --- App Flutter (se pasan con --dart-define; no son secretos) ---
SUPABASE_URL=http://127.0.0.1:54321
# La imprime `supabase start`
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_WEB_CLIENT_ID=
# Habilita el ingreso con correo SOLO en local y CI
MODO_PRUEBAS=true
