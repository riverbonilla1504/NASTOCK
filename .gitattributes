# Finales de línea normalizados. Los scripts y flujos deben tener LF aunque se
# editen en Windows: bash y GitHub Actions fallan con CRLF.
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.ts   text eol=lf
*.dart text eol=lf
*.md   text eol=lf
# deno fmt --check rechaza estos archivos si llegan con CRLF (supabase/functions/deno.json).
*.json text eol=lf
*.lock text eol=lf
*.toml text eol=lf
.env.example text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.ttf  binary
*.jks  binary
*.gpg  binary
