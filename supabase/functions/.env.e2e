# Variables de las Edge Functions en el E2E y en CI (docs/15 §3, docs/10 §9).
# Va en el repositorio, así que NO lleva secretos: solo elige proveedores simulados.
# Uso: supabase functions serve --env-file supabase/functions/.env.e2e
ENTORNO=ci
PROVEEDOR_BROKER=simulado
PROVEEDOR_MERCADO=simulado
PROVEEDOR_NOTICIAS=simulado
PROVEEDOR_CONTEXTO=simulado
PROVEEDOR_JEV=simulado
PROVEEDOR_PUSH=simulado
