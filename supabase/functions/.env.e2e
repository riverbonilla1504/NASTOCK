# Variables de las Edge Functions en el E2E y en CI (docs/15 §3, docs/10 §9).
# Va en el repositorio, así que NO lleva secretos: solo elige proveedores simulados.
# Uso: supabase functions serve --env-file supabase/functions/.env.e2e
ENTORNO=ci
PROVEEDOR_BROKER=simulado
PROVEEDOR_MERCADO=simulado
PROVEEDOR_NOTICIAS=simulado
PROVEEDOR_CONTEXTO=simulado
PROVEEDOR_JEV=simulado
PROVEEDOR_PUSH=simulado

# Reloj de mercado del broker simulado (HU-027): calendario (por defecto, lunes a viernes de
# 9:30 a 16:00 de Nueva York), siempre_abierto, cerrado o cierre_en_10_min. Solo cambia al
# broker simulado; el E2E del mercado en vivo usa siempre_abierto.
RELOJ_SIMULADO=calendario

# Efectivo de la cuenta paper del broker simulado, en USD (HU-015). El E2E-04 registra un aporte de
# 10.000 y la conciliación lo confirma cuando la cuenta lo cubre.
EFECTIVO_SIMULADO=10000
